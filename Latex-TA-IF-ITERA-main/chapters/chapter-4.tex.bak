\subsubsection{Modul 14 --- Hasil Akhir dan Cetak Dokumen Sementara} \label{IV.M14}
% ------------------------------------------------

Setelah daftar ulang diverifikasi, admin validasi mengunggah dua dokumen resmi: NPM Sementara dan KTM Sementara. Dokumen ini kemudian dapat dilihat dan diunduh oleh mahasiswa dari dasbor Hasil Akhir. Endpoint penayangan berkas disediakan oleh \texttt{FileServingController} yang mendukung mode tampil (\textit{inline}) dan mode unduh (\texttt{?download=true}). Tampilan modal Hasil Akhir di dasbor camaba ditunjukkan pada Gambar \ref{fig:4.m14.hasilakhir}.\par

\begin{figure}[H]
	\centering
	\includegraphics[width=0.85\textwidth]{figure/bab4/m14-hasil-akhir.png}
	\caption{Modal Hasil Akhir dengan Tombol Lihat dan Unduh Dokumen Sementara}
	\label{fig:4.m14.hasilakhir}
\end{figure}

\begin{lstlisting}[language=Java, caption={Endpoint upload dokumen sementara oleh admin dan penyajian file via FileServingController}, label={kode:4.m14.hasilakhir}]
// AdminController.java - upload NPM/KTM Sementara
@PostMapping("/admin/api/hasil-akhir/{id}/upload-dokumen")
@PreAuthorize("hasAnyRole('ADMIN_VALIDASI', 'ADMIN_PUSAT')")
public ResponseEntity<?> uploadDokumenSementara(
        @PathVariable Long id,
        @RequestParam(required = false) MultipartFile npmFile,
        @RequestParam(required = false) MultipartFile ktmFile) {
    HasilAkhir ha = hasilAkhirRepo.findById(id).orElseThrow();
    // Simpan ke: uploads/hasil-akhir/{studentId}/npm_sementara_TIMESTAMP.pdf
    if (npmFile != null) {
        String path = fileStorage.save(npmFile, "hasil-akhir/"
            + ha.getStudent().getId());
        ha.setNpmSementaraFile(path);
    }
    hasilAkhirRepo.save(ha);
    return ResponseEntity.ok("Dokumen berhasil diunggah");
}

// FileServingController.java - melayani file ke browser
@GetMapping("/api/files/view/**")
public ResponseEntity<Resource> viewFile(
        HttpServletRequest request,
        @RequestParam(value = "download", required = false) 
        boolean download) {
    String filePath = extractPathFromRequest(request);
    Resource resource = fileStorage.loadAsResource(filePath);
    // Mode download: Content-Disposition: attachment
    // Mode view: Content-Disposition: inline (tampil di browser)
    String disposition = download ? "attachment" : "inline";
    return ResponseEntity.ok()
        .header(HttpHeaders.CONTENT_DISPOSITION,
            disposition + "; filename=\"" + resource.getFilename() + "\"")
        .body(resource);
}
\end{lstlisting}

