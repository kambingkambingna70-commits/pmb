	\label{fig:4.m8.validasiujian}
\end{figure}

\begin{lstlisting}[language=Java, caption={Endpoint penetapan hasil ujian seleksi oleh admin validasi}, label={kode:4.m8.ujian}]
// AdminController.java
@PutMapping("/admin/api/validasi/ujian-result/{formId}")
@PreAuthorize("hasAnyRole('ADMIN_VALIDASI', 'ADMIN_PUSAT')")
public ResponseEntity<?> setHasilUjian(
        @PathVariable Long formId,
        @RequestBody HasilUjianRequest req) {
    // req.result = LULUS | TIDAK_LULUS
    // req.catatan = catatan opsional untuk dikirim ke camaba

    // 1. Update kolom exam_result + exam_validated_by + exam_validated_at
    // 2. Jika LULUS: buka akses tahap daftar ulang
    // 3. Kirim email notifikasi hasil ke camaba via EmailService
    return ResponseEntity.ok(
        validasiService.setHasilUjian(formId, req));
}
\end{lstlisting}

% ------------------------------------------------
\subsubsection{Modul 9 --- Pembayaran Cicilan} \label{IV.M9}
% ------------------------------------------------

Camaba yang tidak mampu membayar lunas dapat mengajukan skema cicilan. Sistem mendukung variasi cicilan dari 1Ã— hingga 6Ã—. Saat pengajuan cicilan disetujui admin, sistem secara otomatis menghasilkan jadwal cicilan berdasarkan harga per tahap yang telah dikonfigurasi untuk program studi bersangkutan (lihat Modul 15). Admin dapat memperbarui status pembayaran setiap tahap secara individual. Tampilan halaman cicilan ditunjukkan pada Gambar \ref{fig:4.m9.cicilan}.\par

\begin{figure}[H]
	\centering
	\includegraphics[width=0.85\textwidth]{figure/bab4/m9-cicilan.png}
	\caption{Halaman Pengajuan dan Status Cicilan Camaba}
	\label{fig:4.m9.cicilan}
\end{figure}

\begin{lstlisting}[language=Java, caption={Endpoint persetujuan cicilan yang memicu pembuatan jadwal cicilan otomatis}, label={kode:4.m9.cicilan}]
// AdminCicilanController.java
@PutMapping("/{id}/approve")
@PreAuthorize("hasAnyRole('ADMIN_PUSAT', 'ADMIN_VALIDASI')")
public ResponseEntity<?> approveCicilan(@PathVariable Long id) {
    CicilanRequest cicilan = cicilanRepo.findById(id).orElseThrow();
    cicilan.setStatus(CicilanRequestStatus.APPROVED);
    cicilan.setApprovedAt(LocalDateTime.now());

    // Generate jadwal cicilan otomatis dari harga per-cicilan program studi
    // Selisih pembulatan diserap oleh cicilan terakhir
    cicilanInstallmentService.generateJadwal(cicilan);

    cicilanRepo.save(cicilan);
    // Kirim email notifikasi berisi BRIVA, total harga, jumlah cicilan
    emailService.sendCicilanApproved(cicilan);
    return ResponseEntity.ok("Cicilan disetujui");
}
\end{lstlisting}

