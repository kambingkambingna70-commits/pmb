\begin{lstlisting}[language=Java, caption={Endpoint lupa kata sandi dan reset kata sandi di AuthController}, label={kode:4.m20.forgotpw}]
// AuthController.java - semua di bawah /api/auth/** -> permitAll()
@PostMapping("/forgot-password")
public ResponseEntity<?> forgotPassword(
        @RequestBody ForgotPasswordRequest req) {
    // 1. Cari user dengan email tersebut
    // 2. Generate UUID sebagai token reset, simpan di password_reset_tokens
    // 3. Set expired_at = sekarang + 1 jam
    // 4. Kirim email berisi link: /reset-password?token=UUID
    authService.sendResetPasswordEmail(req.getEmail());
    return ResponseEntity.ok("Email reset kata sandi telah dikirim");
}

@PostMapping("/reset-password")
public ResponseEntity<?> resetPassword(
        @RequestBody ResetPasswordRequest req) {
    // 1. Validasi token: ada, belum digunakan, belum expired
    // 2. Hash password baru dengan BCrypt
    // 3. Update password user, tandai token sebagai used
    authService.resetPassword(req.getToken(), req.getNewPassword());
    return ResponseEntity.ok("Kata sandi berhasil diubah");
}
\end{lstlisting}

% ============================================================
\subsection{Evaluasi dan Perbaikan Iterasi 1} \label{IV.I1.Evaluasi}
% ============================================================

Setelah seluruh dua puluh modul diimplementasikan, dilakukan evaluasi menyeluruh melalui pengujian fungsional oleh tim pengembang dan demonstrasi langsung kepada pihak klien (Pusat Sistem Informasi UHN). Evaluasi ini menghasilkan sejumlah temuan dan perbaikan yang dilaksanakan sebelum prototipe Iterasi 1 dianggap selesai. Ringkasan temuan dan perbaikan tersebut disajikan pada Tabel \ref{table:4.evaluasi_iterasi1}.\par

\begin{longtable}{|p{0.2\textwidth}|p{0.3\textwidth}|p{0.3\textwidth}|c|}
	\caption{Temuan Evaluasi dan Perbaikan pada Iterasi 1}
	\label{table:4.evaluasi_iterasi1}\\
	\hline
	\textbf{Modul} & \textbf{Temuan} & \textbf{Perbaikan} & \textbf{Status} \\
	\hline
	\endfirsthead
	\hline
	\textbf{Modul} & \textbf{Temuan} & \textbf{Perbaikan} & \textbf{Status} \\
	\hline
	\endhead
	Registrasi (M1) & Token verifikasi email kadaluarsa tidak bisa diperbarui & Endpoint \texttt{resend-verification} ditambahkan & Selesai \\
	\hline
	Autocomplete SMA (M6) & Basis data sekolah tidak mencakup semua sekolah swasta & Kolom \texttt{sekolah\_manual} untuk input alternatif ditambahkan & Selesai \\
	\hline
	Validasi Ujian (M8) & Bukti ujian offline tidak bisa dilihat langsung dari modal & \textit{Embedded preview} berkas ditambahkan dalam modal validasi & Selesai \\
	\hline
	Cicilan (M9) & Nominal cicilan tidak akurat akibat pembulatan & Selisih pembulatan diserap oleh cicilan terakhir & Selesai \\
	\hline
	Harga Cicilan (M15) & Pengisian manual untuk 26 program studi memakan waktu & Fitur salin konfigurasi antar program studi ditambahkan & Selesai \\
	\hline
	Hasil Akhir (M14) & \textit{Bug}: kolom \texttt{nomorRegistrasi} NULL menyebabkan penyimpanan gagal & Auto-generate nomor registrasi format \texttt{REG-YYYYMMDD-ID} sebagai \textit{fallback} & Selesai \\
	\hline
	System Links (M16) & Tidak ada validasi format URL; \textit{footer} masih statis & Validasi \textit{regex} URL ditambahkan; \textit{footer} diperbarui menggunakan \textit{fetch} & Selesai \\
	\hline
	Informasi Kontak (M17) & Perubahan tidak terlihat tanpa \textit{refresh} halaman & \textit{Toast notification} menginformasikan pengguna untuk me-\textit{refresh} & Selesai \\
	\hline
	Ekspor Data (M18) & CSV tanpa baris \textit{header}; \textit{preview} lambat untuk data besar & Header CSV ditambahkan; \textit{preview} dibatasi maksimal 100 baris & Selesai \\
	\hline
	Chat Widget (M19) & \textit{Polling} membebani server saat banyak pengguna aktif & \textit{Timestamp-based polling} diterapkan untuk efisiensi & Selesai \\
	\hline
	Email Cicilan & Email berisi \textit{field} yang tidak perlu (Cicilan 1 DP) & Email disederhanakan: hanya BRIVA, total harga, jumlah cicilan & Selesai \\
	\hline
\end{longtable}

Temuan terpenting pada evaluasi Iterasi 1 adalah \textit{bug} kritis pada modul Hasil Akhir (M14) yang menyebabkan dokumen NPM dan KTM Sementara tidak muncul di dasbor camaba. Investigasi mendalam menemukan bahwa akar permasalahan terletak pada \textit{constraint} basis data: kolom \texttt{nomor\_registrasi} bersifat \texttt{NOT NULL UNIQUE}, namun \textit{front-end} mengirimkan string kosong yang kemudian diabaikan oleh kode \textit{back-end}, sehingga entitas \texttt{HasilAkhir} baru tidak memiliki nilai untuk kolom tersebut dan penyimpanan gagal secara senyap (\textit{silent exception}). Perbaikan dilakukan dengan menambahkan logika \textit{fallback}: apabila nilai \texttt{nomorRegistrasi} kosong dan entitas belum memiliki nomor registrasi, sistem secara otomatis menghasilkan nomor sementara dengan format \texttt{REG-YYYYMMDD-NNNNNN} berdasarkan tanggal sistem dan ID formulir, sebagaimana ditunjukkan pada Kode \ref{kode:4.hasilakhir_fix}.\par

\begin{lstlisting}[language=Java, caption={Perbaikan logika fallback auto-generate nomorRegistrasi di AdminController}, label={kode:4.hasilakhir_fix}]
// AdminController.java - endpoint PUT /admin/api/hasil-akhir/nomor-registrasi/{id}
if (request.getNomorRegistrasi() != null 
        && !request.getNomorRegistrasi().isEmpty()) {
    hasilAkhir.setNomorRegistrasi(request.getNomorRegistrasi());
} else if (hasilAkhir.getNomorRegistrasi() == null 
        || hasilAkhir.getNomorRegistrasi().isEmpty()) {
    // Fallback: auto-generate agar NOT NULL constraint terpenuhi
    // Format: REG-20260419-000042 (tanggal + ID formulir)
    String autoReg = "REG-"
        + LocalDate.now().format(DateTimeFormatter.ofPattern("yyyyMMdd"))
        + "-" + String.format("%06d", formValidationId);
    hasilAkhir.setNomorRegistrasi(autoReg);
    log.info("[HASIL-AKHIR] Auto-generated: {}", autoReg);
}
\end{lstlisting}

