\subsubsection{Modul 17 --- Manajemen Informasi Kontak} \label{IV.M17}
% ------------------------------------------------

Admin Pusat dapat memperbarui informasi kontak institusi (alamat, telepon, email, jam layanan) yang ditampilkan secara dinamis di \textit{footer} seluruh halaman publik. Sistem menggunakan pola \textit{singleton record}: hanya ada satu baris data kontak yang selalu diperbarui. Tampilan manajemen informasi kontak ditunjukkan pada Gambar \ref{fig:4.m17.kontak}.\par

\begin{figure}[H]
	\centering
	\includegraphics[width=0.85\textwidth]{figure/bab4/m17-kontak.png}
	\caption{Halaman Manajemen Informasi Kontak di Dasbor Admin Pusat}
	\label{fig:4.m17.kontak}
\end{figure}

\begin{lstlisting}[language=Java, caption={Endpoint pembaruan informasi kontak institusi dengan pola singleton record}, label={kode:4.m17.kontak}]
// PublicSettingsController.java
@PutMapping("/admin/api/contact-info")
@PreAuthorize("hasRole('ADMIN_PUSAT')")
public ResponseEntity<?> updateContactInfo(
        @RequestBody ContactInfoRequest req) {
    // Pola singleton: ambil record pertama, jika tidak ada buat baru
    ContactInfo info = contactInfoRepo.findFirst()
        .orElse(new ContactInfo());
    info.setAlamat(req.getAlamat());
    info.setTelepon(req.getTelepon());
    info.setEmail(req.getEmail());
    info.setJamLayanan(req.getJamLayanan());
    info.setUpdatedAt(LocalDateTime.now());
    contactInfoRepo.save(info);
    return ResponseEntity.ok("Informasi kontak diperbarui");
}

// Endpoint publik---footer semua halaman memanggil ini saat load
@GetMapping("/api/public/contact-info") // -> permitAll()
public ResponseEntity<?> getContactInfo() {
    return ResponseEntity.ok(contactInfoRepo.findFirst().orElse(null));
}
\end{lstlisting}

