\end{figure}

\begin{lstlisting}[language=Java, caption={Endpoint konfigurasi harga cicilan per program studi}, label={kode:4.m15.prodi}]
// AdminController.java
@PutMapping("/admin/api/program-studi/{id}/cicilan-prices")
@PreAuthorize("hasRole('ADMIN_PUSAT')")
public ResponseEntity<?> setCicilanPrices(
        @PathVariable Long id,
        @RequestBody CicilanPricesRequest req) {
    ProgramStudi prodi = prodiRepo.findById(id).orElseThrow();
    // req berisi hargaCicilan1 s.d. hargaCicilan6
    // Validasi: jumlah semua cicilan tidak boleh melebihi harga total
    prodi.setHargaCicilan1(req.getHargaCicilan1());
    prodi.setHargaCicilan2(req.getHargaCicilan2());
    // ... s.d. setHargaCicilan6
    prodiRepo.save(prodi);
    return ResponseEntity.ok("Harga cicilan berhasil diperbarui");
}
\end{lstlisting}

