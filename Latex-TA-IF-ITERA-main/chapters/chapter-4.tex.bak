// StudentController.java
@PostMapping("/api/students/daftar-ulang/upload")
public ResponseEntity<?> uploadDokumenDaftarUlang(
        @RequestParam("file") MultipartFile file,
        @RequestParam("tipeDoc") String tipeDoc,
        Principal principal) {
    // Validasi tipe file: hanya PDF, JPG, PNG (max 5MB)
    // Simpan ke direktori: uploads/daftar-ulang/{studentId}/{tipeDoc}/
